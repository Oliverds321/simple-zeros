theorem bernD53_pos (s u : ℝ) (hs : 0 < s) (hu : 0 < u) : 0 < bernD53 s u := by
  unfold bernD53; positivity

theorem negderiv_D53 (s : ℝ) : -pRd D53L75.d s = bernD53 s (1 - s) := by
  simp only [D53L75, pRd, pR_cons, pR_nil, bernD53]; push_cast; ring

theorem strictAnti_D53 : StrictAntiOn (pR D53L75.d) (Set.Icc 0 1) := by
  refine strictAntiOn_of_deriv_neg (convex_Icc 0 1) (continuous_pR _).continuousOn fun x hx => ?_
  rw [interior_Icc] at hx
  rw [(hasDerivAt_pR _ x).deriv]
  have h := negderiv_D53 x
  have hb := bernD53_pos x (1 - x) hx.1 (by linarith [hx.2])
  linarith

theorem D53L75_L75' : D53L75.L75 := by
  have hl : (0 : ℝ) < (D53L75.lam : ℝ) := by norm_num [D53L75]
  refine L75_of_cert D53L75 hl strictAnti_D53 ?_ ?_ a_D53 b_D53
  · simp [D53L75]
  · simp only [D53L75, pR_cons, pR_nil]; push_cast; norm_num

