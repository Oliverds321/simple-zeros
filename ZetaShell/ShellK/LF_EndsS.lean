set_option maxHeartbeats 4000000 in
theorem sum_majK2_le_S
    (P : ParamsQ) (Qn : ℕ) (cϱ X : ℝ) (F : LocalFun)
    (hF : LocalHypsCoreW cϱ (toSetting P) F)
