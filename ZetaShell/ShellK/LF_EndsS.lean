theorem nuBound_envSep_abs_S (P : ParamsQ) :
    NuBound (toSetting P) (max |BendsS P| 1) (envSepS P) := by
  intro τ
  have h0 : (0 : ℝ) ≤ logPlusQ P τ := le_max_right _ _
  have hb : |BendsS P| ≤ max |BendsS P| 1 := le_max_left _ _
  have h1 : |envSepS P τ| ≤ |BendsS P| + logPlusQ P τ := by
