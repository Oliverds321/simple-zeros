/-- the Shell ends constant `c₁ = 0.52` (L7_7's C3 `c1EndsShell`). -/
def c1S : ℝ := 0.52

theorem c1S_eq_c1EndsShell : c1S = Design.c1EndsShell := rfl

/-- `B_ends` at `c₁ = 0.52`. -/
def BendsS (P : ParamsQ) : ℝ := c1S * (P.LL + C0Ends) / cMu

/-- the separated envelope at `c₁ = 0.52`. -/
def envSepS (P : ParamsQ) (τ : ℝ) : ℝ := BendsS P + logPlusQ P τ

/-- the family ends majorant at `c₁ = 0.52` (ZetaQ's `endsMaj` with `c1Ends → c1S`). -/
def endsMajS (P : ParamsQ) : ℝ :=
  ((P.aQ * P.LB ^ 2)⁻¹) ^ 2
    * ((c1S * P.Q) ^ 2 * (P.LB ^ 3 * (P.LB + Zeta23.l P.T) * (P.LL + C0Ends) ^ 2
        * (C1ends P.cWin + C2ends P.cWin * (1 + Real.log P.LB))))

set_option maxHeartbeats 4000000 in
theorem S3_continuous_envSep_S (P : ParamsQ) (hT : 0 < P.T) : Continuous (envSepS P) := by
  have hlog : Continuous (logPlusQ P) := by
    rw [continuous_iff_continuousAt]
    intro τ
    rcases eq_or_ne τ 0 with rfl | hτ
    · -- on the ball `|x| < 4T` the `log⁺` is identically `0`, so it is continuous at `0`
      have hev : (fun _ : ℝ => (0 : ℝ)) =ᶠ[nhds (0 : ℝ)] logPlusQ P := by
        filter_upwards [Metric.ball_mem_nhds (0 : ℝ) (by linarith : (0:ℝ) < 4 * P.T)] with x hx
        have hx' : |x| < 4 * P.T := by
          simpa [Real.dist_eq] using hx
        have h0 : (0 : ℝ) ≤ |x| / (4 * P.T) := by positivity
        have h1 : |x| / (4 * P.T) ≤ 1 := by
          rw [div_le_one (by linarith)]; linarith
        show (0 : ℝ) = logPlusQ P x
        rw [logPlusQ, max_eq_right (Real.log_nonpos h0 h1)]
      exact continuousAt_const.congr hev
    · have hne : |τ| / (4 * P.T) ≠ 0 := by
        have : (0 : ℝ) < |τ| := abs_pos.mpr hτ
        positivity
      have hc : ContinuousAt (fun x : ℝ => Real.log (|x| / (4 * P.T))) τ :=
        ContinuousAt.log (by fun_prop) hne
      exact hc.max continuousAt_const
  exact continuous_const.add hlog

set_option maxHeartbeats 4000000 in
theorem S4_nuBound_envSep_S (P : ParamsQ) (hP : P.Valid) :
    NuBound (toSetting P) (BendsS P) (envSepS P) := by
  have hQ : (3 : ℝ) ≤ P.Q := hP.Q_ge
  have hT : (300 : ℝ) ≤ P.T := by
    have h := hP.T_ge; unfold Zeta23.Tail.T₀ at h; exact h
  have hpi : Real.pi ≤ 4 := Real.pi_le_four
  have hLL : (0 : ℝ) ≤ P.LL := by
    unfold ParamsQ.LL
    apply Real.log_nonneg
    rw [le_div_iff₀ (by positivity)]
    nlinarith [mul_le_mul hQ hT (by norm_num : (0:ℝ) ≤ 300) (by linarith : (0:ℝ) ≤ P.Q),
      Real.pi_pos]
  have hBends : (0 : ℝ) ≤ BendsS P := by
    have : (0 : ℝ) ≤ c1S * (P.LL + C0Ends) := by
      unfold c1S C0Ends; linarith
    exact div_nonneg this cMu_pos.le
  intro τ
  have h0 : (0 : ℝ) ≤ logPlusQ P τ := le_max_right _ _
  rw [abs_of_nonneg (by show (0:ℝ) ≤ BendsS P + logPlusQ P τ; linarith)]
  show BendsS P + logPlusQ P τ ≤ BendsS P + logPlusQ P τ
  exact le_rfl

