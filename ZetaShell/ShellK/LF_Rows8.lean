theorem A1_shell (r ε : ℝ) (hr : 3 ≤ r) (hε : 0 < ε) (ε' : ℝ) (hε' : 0 < ε') :
    ∀ᶠ Qn : ℕ in atTop, ∀ P : ParamsQ, Design.ShellDesignM S53L75 r ε (Qn : ℝ) P →
      (P.aQ ^ 2 * P.LB ^ 2)⁻¹ * MAIN8chars Family.qle P Qn ≤ (psi (vDesign P) 0 + ε' / 8) * NfamQ P Family.qle Qn := by
  have hS2 : ((S53L75.lam : ℚ) : ℝ) ≤ 191 / 100 := by norm_num [S53L75]
  have hF : Family.qle.IsFull := Family.isFull_qle
  obtain ⟨A, T₀, hA, hrvm⟩ := EFChi.rvmChi_main_uniform
