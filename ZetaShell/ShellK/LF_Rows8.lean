  obtain ⟨hLL30, hL8, hlam, hw, hQn2⟩ := hbas P hdes
  have hN := hcrude P hdes
  have hQn1 : 1 ≤ Qn := by omega
  have hTpos : 0 < P.T := hP.T_pos
  have hLL0 : 0 < P.LL := by linarith
  have hpi := Real.pi_pos
  have ha0 := hP.aQ_pos
  have hL0 := hP.LB_pos
  have hlogQ : Real.log Qn ≤ P.LL := (log_Qn_le_LL hP hQn1 hQ).1
  have hlogQ0 : 0 ≤ Real.log (Qn:ℝ) := Real.log_natCast_nonneg Qn
  have hK12 : 12 / ε' ≤ K := le_trans (le_max_left _ _) (le_max_right _ _)
  have hKA : 96 * Real.pi * A * Family.qle.Cconst / ε' ≤ K :=
    le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) (le_max_right _ _)
  have hK500 : (500:ℝ) ≤ K := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) (le_max_right _ _)
  have hLL12 : 12 / ε' ≤ P.LL := hK12.trans (hlogK.trans hlogQ)
  have hTA : 96 * Real.pi * A * Family.qle.Cconst / ε' ≤ P.T := hKA.trans hTK
  have hsz500 : 500 * (1 + Real.log Qn) ^ 2 ≤ Qn := by
    have h := hszK
    have hsq : 0 ≤ (1 + Real.log Qn) ^ 2 := sq_nonneg _
    nlinarith
  have hS := sizeR_le_point Family.qle Qn hQn1 hsz500
  have hS0 : 0 ≤ Family.qle.sizeR Qn := by unfold Family.sizeR; positivity
  have hψ := psi0_le hP hw hlam
  have hψ0 := psi0_nonneg hP
  have hE := famEll1Sq_le hP Family.qle Qn hQ
  have hell := famEll1_le P hF Qn hQn2 hA.le hrvm (by rw [hT]; exact hT0) hTpos
  have hfam0 := famEll1_nonneg hP Family.qle Qn
  have hM8 : (P.aQ ^ 2 * P.LB ^ 2)⁻¹ * MAIN8chars Family.qle P Qn
      = psi (vDesign P) 0 * (P.T / (2 * Real.pi)) * (famEll1Sq Family.qle P Qn / P.LL) := by
    rw [MAIN8chars_eq_of_isFull hF, MAIN8_eq_psi P hP Family.qle Qn]; field_simp
  rw [hM8]
  have hlog2 := Real.log_two_lt_d9
  have hc : 2 * Real.log 2 - 1 ≤ 0.3863 := by linarith
  have hE' : famEll1Sq Family.qle P Qn / P.LL ≤ (1 + 0.3863 / P.LL) * famEll1 Family.qle P Qn := by
    rw [div_le_iff₀ hLL0]
    have h1 : (P.LL + (2 * Real.log 2 - 1)) * famEll1 Family.qle P Qn ≤ (P.LL + 0.3863) * famEll1 Family.qle P Qn :=
      mul_le_mul_of_nonneg_right (by linarith) hfam0
    have e : (1 + 0.3863 / P.LL) * famEll1 Family.qle P Qn * P.LL = (P.LL + 0.3863) * famEll1 Family.qle P Qn := by
      field_simp
    rw [e]; linarith
  have hrat : 0.3863 / P.LL ≤ 0.033 * ε' := by
    rw [div_le_iff₀ hLL0]
    have := hLL12; rw [div_le_iff₀ hε'] at this
    nlinarith
  have h14 : 1 + 0.3863 / P.LL ≤ 1.4 := by
    have : 0.3863 / P.LL ≤ 0.4 := by rw [div_le_iff₀ hLL0]; linarith
    linarith
  have h14' : 0 ≤ 1 + 0.3863 / P.LL := by positivity
  have hmain : psi (vDesign P) 0 * (P.T / (2 * Real.pi)) * (famEll1Sq Family.qle P Qn / P.LL)
      ≤ psi (vDesign P) 0 * (1 + 0.3863 / P.LL)
          * (NfamQ P Family.qle Qn + Family.qle.sizeR Qn * (A * Real.log ((Qn : ℝ) * (P.T + 2)))) := by
    calc psi (vDesign P) 0 * (P.T / (2 * Real.pi)) * (famEll1Sq Family.qle P Qn / P.LL)
        ≤ psi (vDesign P) 0 * (P.T / (2 * Real.pi)) * ((1 + 0.3863 / P.LL) * famEll1 Family.qle P Qn) := by
          gcongr
      _ = psi (vDesign P) 0 * (1 + 0.3863 / P.LL) * ((P.T / (2 * Real.pi)) * famEll1 Family.qle P Qn) := by ring
      _ ≤ _ := by gcongr
  have hN0 : 0 ≤ NfamQ P Family.qle Qn := NfamQ_nonneg P Family.qle Qn
  have hsmall1 : psi (vDesign P) 0 * (0.3863 / P.LL) * NfamQ P Family.qle Qn ≤ ε' / 16 * NfamQ P Family.qle Qn := by
    apply mul_le_mul_of_nonneg_right _ hN0
    calc psi (vDesign P) 0 * (0.3863 / P.LL) ≤ (16 / 9) * (0.033 * ε') :=
          mul_le_mul hψ hrat (by positivity) (by norm_num)
      _ ≤ ε' / 16 := by linarith
  have hsmall2 : psi (vDesign P) 0 * (1 + 0.3863 / P.LL)
        * (Family.qle.sizeR Qn * (A * Real.log ((Qn : ℝ) * (P.T + 2)))) ≤ ε' / 16 * NfamQ P Family.qle Qn := by
    have h1 : psi (vDesign P) 0 * (1 + 0.3863 / P.LL) ≤ 2.5 := by
      calc psi (vDesign P) 0 * (1 + 0.3863 / P.LL) ≤ (16 / 9) * 1.4 :=
            mul_le_mul hψ h14 h14' (by norm_num)
        _ ≤ 2.5 := by norm_num
    have hlogQT0 : 0 ≤ Real.log ((Qn : ℝ) * (P.T + 2)) := by
      apply Real.log_nonneg
      have : (1:ℝ) ≤ Qn := by exact_mod_cast hQn1
      nlinarith
    have hAlog0 : 0 ≤ A * Real.log ((Qn : ℝ) * (P.T + 2)) := mul_nonneg hA.le hlogQT0
    have h2 : Family.qle.sizeR Qn * (A * Real.log ((Qn : ℝ) * (P.T + 2)))
        ≤ 0.2 * (Qn:ℝ) ^ 2 * (A * (3 * P.LL)) := by
      apply mul_le_mul hS _ hAlog0 (by positivity)
      apply mul_le_mul_of_nonneg_left _ hA.le
      linarith
    have key : 96 * Real.pi * A * Family.qle.Cconst ≤ ε' * P.T := by
      rw [div_le_iff₀ hε'] at hTA; linarith
    have h3 : 2.5 * (0.2 * (Qn:ℝ) ^ 2 * (A * (3 * P.LL)))
        ≤ ε' / 16 * ((Qn : ℝ) ^ 2 * P.T * P.LL / (4 * Real.pi * Family.qle.Cconst)) := by
      rw [show 2.5 * (0.2 * (Qn:ℝ) ^ 2 * (A * (3 * P.LL)))
          = (96 * Real.pi * A * Family.qle.Cconst) * ((Qn:ℝ) ^ 2 * P.LL) / (64 * Real.pi * Family.qle.Cconst) by
            first | (field_simp; ring) | field_simp,
        show ε' / 16 * ((Qn : ℝ) ^ 2 * P.T * P.LL / (4 * Real.pi * Family.qle.Cconst))
          = (ε' * P.T) * ((Qn:ℝ) ^ 2 * P.LL) / (64 * Real.pi * Family.qle.Cconst) by ring]
      gcongr
    calc psi (vDesign P) 0 * (1 + 0.3863 / P.LL) * (Family.qle.sizeR Qn * (A * Real.log ((Qn : ℝ) * (P.T + 2))))
        ≤ 2.5 * (0.2 * (Qn:ℝ) ^ 2 * (A * (3 * P.LL))) :=
          mul_le_mul h1 h2 (mul_nonneg hS0 hAlog0) (by norm_num)
      _ ≤ ε' / 16 * ((Qn : ℝ) ^ 2 * P.T * P.LL / (4 * Real.pi * Family.qle.Cconst)) := h3
      _ ≤ ε' / 16 * NfamQ P Family.qle Qn := by gcongr
  have hfinal : psi (vDesign P) 0 * (1 + 0.3863 / P.LL)
        * (NfamQ P Family.qle Qn + Family.qle.sizeR Qn * (A * Real.log ((Qn : ℝ) * (P.T + 2))))
      = psi (vDesign P) 0 * NfamQ P Family.qle Qn + psi (vDesign P) 0 * (0.3863 / P.LL) * NfamQ P Family.qle Qn
        + psi (vDesign P) 0 * (1 + 0.3863 / P.LL)
            * (Family.qle.sizeR Qn * (A * Real.log ((Qn : ℝ) * (P.T + 2)))) := by ring
  linarith [hmain, hfinal, hsmall1, hsmall2]

