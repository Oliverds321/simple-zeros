ZetaShell.LemmaK.theorem_one_prime_design : ∀ (r ε : ℝ),
  3 ≤ r →
    0 < ε →
      ∃ Q₀ c,
        0 < c ∧
          ∀ (Qn : ℕ),
            Q₀ ≤ ↑Qn →
              (↑ZetaShell.LemmaK.PcertKD - c * Real.log (Real.log ↑Qn) / Real.log ↑Qn) *
                  ZetaQ.NfamCount ZetaQ.Family.qle Qn (ZetaQ.Twin (↑Qn) r ε) (2 * ZetaQ.Twin (↑Qn) r ε) ≤
                ZetaQ.N0sFamCount ZetaQ.Family.qle Qn (ZetaQ.Twin (↑Qn) r ε) (2 * ZetaQ.Twin (↑Qn) r ε)
