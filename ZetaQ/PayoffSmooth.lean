/-- the real-valued `B0`, `B1` of `certQQsmooth` (§3c Gram route, RESOLUTIONS D24). -/
theorem B0B1_certQQsmooth :
    B0 certQQsmooth.toFun = ((B0_certQQsmooth : ℚ) : ℝ)
      ∧ B1 certQQsmooth.toFun = ((B1_certQQsmooth : ℚ) : ℝ) := by
  obtain ⟨h0, h1⟩ := two_cell_payoff' certQQsmooth certQQsmooth_NonnegOK certQQsmooth_MassOK
    (certQQsmooth.coeff.getD 0 []) (certQQsmooth.coeff.getD 1 []) (by norm_num [certQQsmooth])
    (by rfl)
  refine ⟨h0.trans ?_, h1.trans ?_⟩ <;>
  · norm_num (maxSteps := 400000000) [certQQsmooth, B0_certQQsmooth, B1_certQQsmooth, gramB0,
      gramB1, gramI2, gramM, gramN, gramTop, gramPhi0, gramPhi1, gramInner, pdefint, pevalQ, pint,
      pintAux, pmul, padd, pscal, psub, pcomp]

/-- **§11 at `C = π⁴/18` for the SMOOTH design profile, in feasibility form**: an admissible
profile at the design bandwidth `λ* = 1.2507321515` with `B ≤ 2 − 0.7212`. Its profile is
`certQQsmooth.toFun = designProfileQle²/∫` on `[−λ*/2, λ*/2]` (data by construction).
Rule 17: the bandwidth is the literal `λ* > 1`. -/
theorem payoff_feasible_qQ_smooth :
    ∃ v : ℝ → ℝ, Admissible lamStar v ∧
      B (Real.pi ^ 4 / 18) v ≤ 2 - ((Pcert_qQ_smooth : ℚ) : ℝ) := by
  obtain ⟨hadm, hB⟩ :=
    payoff_of_cert_num certQQsmooth certQQsmooth_NonnegOK certQQsmooth_MassOK
      B0_certQQsmooth B1_certQQsmooth B0B1_certQQsmooth.1 B0B1_certQQsmooth.2
      (Real.pi ^ 4 / 18) (5412 / 1000) Pcert_qQ_smooth (by norm_num) C_qQ_le
      (by norm_num [B0_certQQsmooth, B1_certQQsmooth, Pcert_qQ_smooth])
  refine ⟨certQQsmooth.toFun, ?_, hB⟩
  have hl : ((certQQsmooth.lam : ℚ) : ℝ) = lamStar := by
    norm_num [Cert.lam, certQQsmooth, lamStar]
  rwa [hl] at hadm

